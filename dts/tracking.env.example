# ============================================================================
#  tracking.env  -  settings for the Docker / Synology deployment
#
#  1. Copy this file to  tracking.env  (same folder as docker-compose.yml)
#  2. Change every line marked  <-- CHANGE
#
#  Passwords: use only letters, numbers, "-" and "_" (no  $  #  "  '  or spaces),
#  because Docker treats those characters specially.
#
#  IMPORTANT: choose the two database passwords NOW and do not change them later.
#  The database stores them the first time it starts; editing this file afterwards
#  does NOT change the database (the app would then fail with "Access denied").
# ============================================================================

# ---- Application -----------------------------------------------------------
APP_NAME=TrackingSystem
APP_ENV=production
APP_DEBUG=false
# The address people type in the browser, INCLUDING the port, no trailing slash   <-- CHANGE
# (the port must match the left number of "ports:" in docker-compose.yml)
APP_URL=http://192.168.1.50:8081
# Leave empty: a key is generated on first start and kept in data/storage/.app_key
APP_KEY=
TZ=Asia/Manila

# ---- Database (MariaDB) ----------------------------------------------------
# The app and the database container both read these four lines.
MARIADB_DATABASE=tracking_system
MARIADB_USER=tracker
# CHANGE both passwords below (make them long, and different from each other)
MARIADB_PASSWORD=CHANGE_ME_db_password
MARIADB_ROOT_PASSWORD=CHANGE_ME_root_password

# ---- Laravel behaviour (normally leave as is) ------------------------------
LOG_CHANNEL=stderr
LOG_LEVEL=info
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12
